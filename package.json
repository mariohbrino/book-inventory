{
  "name": "book-inventory",
  "version": "0.1.0",
  "description": "A simple book inventory API",
  "type": "module",
  "author": {
    "name": "Mario Brino",
    "email": "mariobrino@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "concurrently --names server,openapi --prefix-colors blue,magenta \"npm run dev:server\" \"npm run dev:openapi\"",
    "dev:server": "node --env-file .env --watch src/server.js",
    "dev:openapi": "nodemon --watch src --ext js --ignore src/openapi.json --exec \"node --env-file .env src/openapi.js\"",
    "openapi": "node --env-file .env src/openapi.js",
    "prestart": "node src/openapi.js",
    "start": "node src/server.js",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --reporter=verbose",
    "test:units": "vitest run --reporter=verbose --project=unit-tests",
    "test:features": "vitest run --reporter=verbose --project=feature-tests",
    "test:coverage": "vitest run --reporter=verbose --coverage"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.10.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "supertest": "^7.3.0",
    "swagger-autogen": "^2.23.7",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@scarf/scarf@1.4.0": true
  }
}
